# The default keeps the existing localhost wallet flow.
VITE_DIVIDENDX_NETWORK=local
VITE_DIVIDENDX_RUNTIME_URL=http://127.0.0.1:4180

# Public builds use the bounded same-origin service and pinned Solana devnet RPC.
# VITE_DIVIDENDX_NETWORK=devnet
# VITE_DIVIDENDX_RUNTIME_URL=/api/devnet
# VITE_DIVIDENDX_DEVNET_RPC_URL=https://api.devnet.solana.com
