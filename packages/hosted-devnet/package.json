{
  "name": "@dividendx/hosted-devnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "npm --prefix ../transaction-sdk run build --silent && npm --prefix ../devnet-runtime run build --silent && npm --prefix ../hosted-broker run build --silent && tsc -p tsconfig.json",
    "typecheck": "npm run build --silent && tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@dividendx/devnet-runtime": "file:../devnet-runtime",
    "@dividendx/hosted-broker": "file:../hosted-broker",
    "@dividendx/transaction-sdk": "file:../transaction-sdk",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@vercel/blob": "2.8.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "rpc-websockets": "9.3.10"
  },
  "engines": {
    "node": ">=24"
  }
}
