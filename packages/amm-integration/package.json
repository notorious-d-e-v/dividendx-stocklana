{
  "name": "@dividendx/amm-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist", "README.md", "manifests", "evidence"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "preflight": "npm run build --silent && node dist/src/cli.js preflight",
    "run:public": "npm run build --silent && node dist/src/cli.js public",
    "run:local": "npm run build --silent && node dist/src/cli.js local"
  },
  "dependencies": {
    "@dividendx/transaction-sdk": "file:../transaction-sdk",
    "@raydium-io/raydium-sdk-v2": "0.2.64-alpha",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=24" }
}
