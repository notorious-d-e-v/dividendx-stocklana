{
  "name": "@dividendx/hosted-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" },
    "./json-store": { "types": "./dist/src/json-store.d.ts", "default": "./dist/src/json-store.js" },
    "./security": { "types": "./dist/src/security.d.ts", "default": "./dist/src/security.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.8",
    "@vercel/sandbox": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
