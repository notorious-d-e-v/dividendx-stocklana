{
  "name": "@dividendx/guided-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build --silent && node dist/src/server.js",
    "smoke": "npm run build --silent && node dist/scripts/smoke.js"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.0-rc.5",
    "@dividendx/amm-integration": "file:../amm-integration",
    "@dividendx/transaction-sdk": "file:../transaction-sdk",
    "@raydium-io/raydium-sdk-v2": "0.2.64-alpha",
    "@solana/spl-token": "0.4.14",
    "@solana/surfpool": "1.5.0",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=24" }
}
