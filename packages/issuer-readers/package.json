{
  "name": "@dividendx/issuer-readers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build:sdk": "npm --prefix ../transaction-sdk run build",
    "build": "npm run build:sdk --silent && tsc -p tsconfig.json",
    "typecheck": "npm run build:sdk --silent && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "read": "npm run build --silent && node dist/src/cli.js",
    "review": "npm run build --silent && node dist/src/qualification-cli.js review"
  },
  "dependencies": {
    "@dividendx/transaction-sdk": "file:../transaction-sdk",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4"
  },
  "engines": { "node": ">=24" }
}
